# Copy to .env and fill in. The provider keys are secret.

# --- Model provider ---
# Provider is per-AgentConfig (Gemini or OpenRouter). The runner passes the key
# the config's provider needs: gemini -> GEMINI_API_KEY, openrouter ->
# OPENROUTER_API_KEY. Default experiment runs on OpenRouter because the Gemini
# free tier is exhausted under agent load (see docs/LIMITS.md). Fill the key(s)
# for whichever provider(s) your configs use.
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_evals

# --- Runner ---
# fake   = replay recorded trajectories (no key, no cost) — default, used by tests/demo
# hermes = real one-shot `hermes chat -q` per trial in a throwaway Docker volume
RUNNER=fake
HERMES_IMAGE=nousresearch/hermes-agent:v2026.9.24

# --- API / worker ---
PORT=3000
WORKER_CONCURRENCY=2
