# Copy to .env and fill in. Only GEMINI_API_KEY is secret.

# --- Model provider (Phase 0): Hermes uses provider=gemini with this key ---
GEMINI_API_KEY=your-gemini-api-key

# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_evals

# --- Runner ---
# fake   = replay recorded trajectories (no key, no cost) — default, used by tests/demo
# hermes = real one-shot `hermes chat -q` per trial in a throwaway Docker volume
RUNNER=fake
HERMES_IMAGE=nousresearch/hermes-agent:v2026.9.24

# --- API / worker ---
PORT=3000
WORKER_CONCURRENCY=2
