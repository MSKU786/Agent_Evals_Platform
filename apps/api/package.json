{
  "name": "@agent-evals/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:api": "ts-node --transpile-only -P tsconfig.json src/main.ts",
    "start:api": "ts-node --transpile-only -P tsconfig.json src/main.ts",
    "dev:worker": "ts-node --transpile-only -P tsconfig.json src/worker.ts",
    "start:worker": "ts-node --transpile-only -P tsconfig.json src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "derisk": "tsx scripts/derisk.ts",
    "smoke": "tsx scripts/smoke-suite.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-evals/shared": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@prisma/client": "5.22.0",
    "js-yaml": "4.1.0",
    "pg-boss": "10.1.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.9.0",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
